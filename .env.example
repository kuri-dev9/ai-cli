# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=18200
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# -----------------------------------------------------------------------------
# CLAUDE 설정 디렉터리 / 인증 (선택)
# -----------------------------------------------------------------------------
#
# CLAUDE_CONFIG_DIR — Claude Code 의 설정·세션 저장 위치를 옮깁니다.
#
# 개인 계정과 업무 계정을 나눠 쓸 때 사용합니다. 로그인할 때도 같은 값을 주고
# 로그인해야 합니다:
#
#   CLAUDE_CONFIG_DIR=$HOME/.claude-work claude
#
# 반드시 절대 경로로 적으세요. `~/.claude-work` 처럼 틸드로 적으면 서버는 풀어서
# 읽지만 Claude CLI 자식 프로세스에는 그대로 전달되어 엉뚱한 경로를 만듭니다.
# 한쪽만 설정하면 세션 목록은 보이는데 대화만 안 되는 상태가 됩니다.
#
# CLAUDE_CONFIG_DIR=/Users/이름/.claude-work

# CLAUDE_CODE_OAUTH_TOKEN — 키체인 대신 토큰으로 인증합니다.
#
# ssh 로만 접근하는 원격 맥에서는 사실상 필수입니다. macOS 의 Claude Code 는
# 자격증명을 키체인에 두는데, login 키체인은 맥 화면에서 직접 로그인할 때만 열리고
# ssh 세션은 그 잠금 해제를 물려받지 못합니다. 그래서 ssh 에서 서버를 재시작하는
# 순간부터 "Not logged in" 이 납니다. 로그인이 풀린 게 아니라 꺼낼 수 없는 것이라,
# 재로그인해도 해결되지 않습니다.
#
# 발급:
#   security unlock-keychain ~/Library/Keychains/login.keychain-db
#   claude setup-token
#
# 브라우저 승인 후 코드를 붙여넣으면 그 **다음에** 출력되는 sk-ant-oat01- 로
# 시작하는 값이 토큰입니다. 붙여넣는 코드(가운데 # 가 있는 값)가 아닙니다.
#
# 넣은 뒤 chmod 600 .env 로 권한을 좁히세요. 값 뒤에 주석을 달면 그것까지 토큰에
# 포함되므로 주의하세요. 자세한 내용은 docs/local/team-setup.md 를 보세요.
#
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# -----------------------------------------------------------------------------
# HTTPS (선택 사항 — 기본값은 HTTP)
# -----------------------------------------------------------------------------
#
# 이 맥에서만 쓴다면 켤 필요가 없습니다. 브라우저는 http://localhost 를 이미
# 안전한 출처(secure context)로 취급합니다.
#
# 폰/태블릿에서 http://192.168.x.x 로 붙는다면 로그인 토큰이 같은 네트워크에
# 평문으로 흐릅니다. 그 경우에만 아래를 켜세요.
#
# 켜는 순서:
#   1) ./bin/generate-cert.sh        # certs/server.key, certs/server.crt 생성
#   2) HTTPS_ENABLED=true                # 아래 주석 해제
#   3) 서버 재시작
#
# 주의: HTTPS_ENABLED=true 인데 인증서를 읽지 못하면 서버는 HTTP 로 폴백하지 않고
#       에러를 내며 멈춥니다. 암호화됐다고 착각한 채 평문으로 도는 것이 더 위험합니다.
#
# 주의: 자체 서명(openssl) 인증서는 브라우저 경고가 뜨고 service worker 가
#       등록되지 않아 웹 푸시/홈 화면 PWA 설치가 동작하지 않습니다.
#       경고 없이 쓰려면 mkcert 를 설치한 뒤 generate-cert.sh 를 다시 돌리고,
#       생성된 로컬 CA 를 폰에도 설치하세요.
#
# HTTPS_ENABLED=false

# 인증서 경로 (생략하면 certs/server.key, certs/server.crt 를 씁니다)
# 상대 경로는 저장소 루트 기준입니다.
# HTTPS_KEY_PATH=certs/server.key
# HTTPS_CERT_PATH=certs/server.crt

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000


# =============================================================================
# TELEGRAM BRIDGE (선택)
# =============================================================================
#
# 텔레그램에서 명령을 보내고 결과를 받는 통로입니다. long polling 만 쓰므로
# 포트를 열거나 공인 IP 를 준비할 필요가 없습니다 — 서버가 텔레그램 쪽으로
# 나가는 연결만 만듭니다.
#
# 1) @BotFather 에서 봇을 만들고 토큰을 받습니다.
# 2) 같은 곳에서 /setjoingroups 를 Disable 로 둡니다. (1:1 대화만 남깁니다)
# 3) 만든 봇에게 아무 말이나 보낸 뒤,
#    https://api.telegram.org/bot<토큰>/getUpdates 를 열어 chat.id 를 확인합니다.
#
# 두 값이 모두 있어야 브리지가 켜집니다. 화이트리스트가 비어 있으면 브리지는
# 시작하지 않습니다 — 봇 username 은 검색으로 알아낼 수 있어서, 이 목록이
# 사실상 유일한 잠금장치입니다.
#
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_ALLOWED_CHAT_IDS=12345678
#
# 폰에서 보낸 작업에 무엇까지 허용할지는 설정 화면(설정 > 텔레그램)에서 고릅니다.
# 기본은 "묻기" 이고, 승인 창은 브라우저에만 뜨므로 폰에서 작업을 이어 하려면
# "읽기만 허용" 이나 "전부 허용" 으로 바꿔야 합니다.
